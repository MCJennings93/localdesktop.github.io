#!/bin/sh
# Installs an APK from ~/localdesktop-bench/apks/, restarts Local Desktop, checks that the shell is
# up, then runs ld-framebench twice under the build's ID. Usage: ld-abrun <build-id>
# LD_PKG picks the app: io.github.localdesktop (default) or app.polarbear (builds before the rename).
PKG=${LD_PKG:-io.github.localdesktop}
set -eu
ID=$1
S=~/localdesktop-bench/ab-$ID; mkdir -p "$S"
adb install -r ~/localdesktop-bench/apks/$ID.apk | tail -1
adb shell am force-stop $PKG; sleep 2
adb shell am start -n $PKG/android.app.NativeActivity >/dev/null; sleep 50
GOT=$(adb shell "run-as $PKG cat files/arch/etc/localdesktop/build-id" | tr -d '\r')
echo "build-id on device: $GOT"; [ "$GOT" = "$ID" ] || { echo "WRONG BUILD" >&2; exit 1; }
adb exec-out screencap -p -d 4630947175568309891 > "$S/shell.png"
"$(dirname "$0")"/ld-run 'echo "shell threads $(ls /proc/$(pgrep -x plasmashell)/task | wc -l)"' 30
for i in 1 2; do "$(dirname "$0")"/ld-framebench "$ID-r$i" > "$S/framebench-r$i.txt" 2>&1; echo "framebench r$i done"; done
