+/* A DRM render node that is this KGSL device itself (the same character device bound under
+ * /dev/dri, as some containers do so DRM-based software finds the GPU), reported through
+ * VK_EXT_physical_device_drm. Without it, Wayland compositors that pick their render node
+ * from Vulkan (gamescope) find none and can offer clients no dma-buf.
+ */
+static bool
+kgsl_find_render_node(int fd, int64_t *major_out, int64_t *minor_out)
+{
+   struct stat kgsl_st;
+   if (fstat(fd, &kgsl_st) != 0 || !S_ISCHR(kgsl_st.st_mode))
+      return false;
+
+   /* Render nodes are usually renderD128 and up; a bind may use any number. */
+   for (int n = 0; n < 256; n++) {
+      char path[32];
+      struct stat st;
+      snprintf(path, sizeof(path), "/dev/dri/renderD%d", n);
+      if (stat(path, &st) == 0 && S_ISCHR(st.st_mode) && st.st_rdev == kgsl_st.st_rdev) {
+         *major_out = major(st.st_rdev);
+         *minor_out = minor(st.st_rdev);
+         return true;
+      }
+   }
+   return false;
+}
