 #include "win32_styles.h"
 #include "edid.h"
 #include "hdmi.h"
@@ -6915,6 +6916,18 @@ static inline float santitize_float( float f )
 // resolution, which reads that screen's size back, shrinks with it. An ignored request is answered as
 // one that needs no change: the property is deleted, which is how gamescope says a request is done.
 // Left in place, the client repeats it and then crashes (SIGSEGV seconds after starting).
+// With GAMESCOPE_NATIVE_GAMES_FOLLOW_OUTPUT=1, a game server at the native size follows output
+// changes (rotation, fold) as Steam's own server does; see Utils/NativeGameFollow.h.
+static bool NativeGamesFollowOutput()
+{
+	static const bool s_bFollow = []
+	{
+		const char *pszFollow = getenv( "GAMESCOPE_NATIVE_GAMES_FOLLOW_OUTPUT" );
+		return pszFollow && atoi( pszFollow ) != 0;
+	}();
+	return s_bFollow;
+}
+
 static bool SteamScreenFollowsWindow( size_t server_idx, int width, int height )
 {
 	static const bool s_bFollow = []
@@ -10375,6 +10388,16 @@ steamcompmgr_main(int argc, char **argv)
 				wlserver_lock();
 				// Update only Steam, the root ctx, with the new output size for now
 				wlserver_set_xwayland_server_mode( 0, g_nOutputWidth, g_nOutputHeight, g_nOutputRefresh );
+				if ( NativeGamesFollowOutput() )
+				{
+					gamescope_xwayland_server_t *game_server = NULL;
+					for ( size_t i = 1; ( game_server = wlserver_get_xwayland_server( i ) ); i++ )
+					{
+						if ( gamescope::GameServerFollowsOutput( game_server->ctx->root_width, game_server->ctx->root_height,
+								currentOutputWidth, currentOutputHeight, g_nOutputWidth, g_nOutputHeight ) )
+							wlserver_set_xwayland_server_mode( i, g_nOutputWidth, g_nOutputHeight, g_nOutputRefresh );
+					}
+				}
 				wlserver_unlock();
 			}
 
