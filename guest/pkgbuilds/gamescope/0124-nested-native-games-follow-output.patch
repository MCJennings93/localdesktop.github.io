diff --git a/src/Utils/NativeGameFollow.h b/src/Utils/NativeGameFollow.h
new file mode 100644
index 0000000..7d52055
--- /dev/null
+++ b/src/Utils/NativeGameFollow.h
@@ -0,0 +1,22 @@
+#pragma once
+
+#include <cstdint>
+
+namespace gamescope
+{
+    // With several Xwayland servers, gamescope resizes only Steam's (#0) when the output changes
+    // (rotation, fold, window resize); a game server keeps the size Steam gave it at launch, and its
+    // picture is then scaled into the new shape with bars. A game server still at the old output's
+    // size was running at the native size, so it follows the output. One at any other size had a
+    // size chosen for it (Steam's per-game Game Resolution) and keeps it.
+    constexpr bool GameServerFollowsOutput( int32_t nRootWidth, int32_t nRootHeight,
+                                            uint32_t uOldWidth, uint32_t uOldHeight,
+                                            uint32_t uNewWidth, uint32_t uNewHeight )
+    {
+        if ( uOldWidth == 0 || uOldHeight == 0 || uNewWidth == 0 || uNewHeight == 0 )
+            return false;
+        if ( uOldWidth == uNewWidth && uOldHeight == uNewHeight )
+            return false;
+        return nRootWidth == int32_t( uOldWidth ) && nRootHeight == int32_t( uOldHeight );
+    }
+}
