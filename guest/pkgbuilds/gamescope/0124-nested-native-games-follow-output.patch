diff --git a/tests/test_native_game_follow.cpp b/tests/test_native_game_follow.cpp
new file mode 100644
index 0000000..dfcd3bc
--- /dev/null
+++ b/tests/test_native_game_follow.cpp
@@ -0,0 +1,33 @@
+#include <catch2/catch_test_macros.hpp>
+
+#include "Utils/NativeGameFollow.h"
+
+using namespace gamescope;
+
+TEST_CASE("a game at the native size follows rotation", "[native_game_follow]")
+{
+    REQUIRE( GameServerFollowsOutput( 2176, 1811, 2176, 1811, 1811, 2176 ) );
+    REQUIRE( GameServerFollowsOutput( 1811, 2176, 1811, 2176, 2176, 1811 ) );
+}
+
+TEST_CASE("a game at the native size follows a fold", "[native_game_follow]")
+{
+    REQUIRE( GameServerFollowsOutput( 2176, 1811, 2176, 1811, 2315, 903 ) );
+}
+
+TEST_CASE("a game with its own size keeps it", "[native_game_follow]")
+{
+    REQUIRE_FALSE( GameServerFollowsOutput( 1920, 1080, 2176, 1811, 1811, 2176 ) );
+    REQUIRE_FALSE( GameServerFollowsOutput( 1811, 1080, 2176, 1811, 1811, 2176 ) );
+}
+
+TEST_CASE("no change without a new size", "[native_game_follow]")
+{
+    REQUIRE_FALSE( GameServerFollowsOutput( 2176, 1811, 2176, 1811, 2176, 1811 ) );
+}
+
+TEST_CASE("no change before an output size is known", "[native_game_follow]")
+{
+    REQUIRE_FALSE( GameServerFollowsOutput( 0, 0, 0, 0, 1811, 2176 ) );
+    REQUIRE_FALSE( GameServerFollowsOutput( 2176, 1811, 2176, 1811, 0, 0 ) );
+}
