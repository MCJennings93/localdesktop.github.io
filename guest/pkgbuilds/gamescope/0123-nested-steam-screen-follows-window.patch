+// With GAMESCOPE_STEAM_SCREEN_FOLLOWS_WINDOW=1 and more than one Xwayland server, the Steam client's
+// server (#0) keeps the output's size: its requests to resize it are ignored. Games run on the other
+// servers, whose sizes Steam still sets per game (Game Resolution). Without this, the client shrinks
+// its own screen to 1920x1080 (clamped to the output) on a larger output, and its "Native" game
+// resolution, which reads that screen's size back, shrinks with it. An ignored request is answered as
+// one that needs no change: the property is deleted, which is how gamescope says a request is done.
+// Left in place, the client repeats it and then crashes (SIGSEGV seconds after starting).
+static bool SteamScreenFollowsWindow( size_t server_idx, int width, int height )
+{
+	static const bool s_bFollow = []
+	{
+		const char *pszFollow = getenv( "GAMESCOPE_STEAM_SCREEN_FOLLOWS_WINDOW" );
+		return pszFollow && atoi( pszFollow ) != 0;
+	}();
+	if ( !s_bFollow || server_idx != 0 || g_nXWaylandCount < 2 )
+		return false;
+	xwm_log.infof( "Keeping xwayland server #0 at the output's size %dx%d (Steam asked for %dx%d)",
+		g_nOutputWidth, g_nOutputHeight, width, height );
+	gamescope_xwayland_server_t *root_server = wlserver_get_xwayland_server( 0 );
+	if ( root_server )
+	{
+		xwayland_ctx_t *root_ctx = root_server->ctx.get();
+		XDeleteProperty( root_ctx->dpy, root_ctx->root, root_ctx->atoms.gamescopeXWaylandModeControl );
+		XFlush( root_ctx->dpy );
+	}
+	return true;
+}
