[Desktop Entry]
Type=Application
Name=Steam
Comment=Steam's Steam Deck UI in Game Mode (gamescope)
Exec=/usr/local/bin/localdesktop-gamemode %U
Icon=/root/.local/share/Steam/public/steam_tray_posix.png
Terminal=false
Categories=Game;
MimeType=x-scheme-handler/steam;x-scheme-handler/steamlink;
Actions=Restart;Desktop;

[Desktop Action Restart]
Name=Restart Steam
Exec=/usr/local/bin/localdesktop-gamemode --restart

[Desktop Action Desktop]
Name=Steam in Desktop Mode
Exec=/usr/local/bin/localdesktop-steam --restart --desktop
