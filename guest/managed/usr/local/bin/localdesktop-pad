#!/usr/bin/python3
# The emulated Steam Deck controller: /usr/local/lib/libfakeinput.so (DroidDeck's, preloaded into the
# Steam client by localdesktop-steam) serves it to Steam as /dev/hidraw16 and reads its state from a
# ring file. This tool describes the device in sysfs and udev, creates the ring, and sets its state.
# The sysfs layout and the ring format follow DroidDeck 4f58230a SteamDeckPad.kt and
# FakeInputWriter.java (GPL-3.0); /sys/devices/droiddeck and /sys/class/hidraw are bound by the app.
#
#   localdesktop-pad setup            describe the pad and create the ring (session start)
#   localdesktop-pad env              the variables libfakeinput needs, as shell assignments
#   localdesktop-pad press A [B ...]  hold buttons     localdesktop-pad release [A ...]  (none: all)
#   localdesktop-pad tap A [ms]       press and release
#   localdesktop-pad stick left|right X Y    -1..1      localdesktop-pad trigger left|right 0..1
#   localdesktop-pad dpad up|down|left|right|none       localdesktop-pad state
#   localdesktop-pad --slot N COMMAND ...  the same on slot N's ring (1 to 3: a physical controller's)
import mmap
import os
import shlex
import shutil
import struct
import sys
import time

RUN = "/run/localdesktop-pad"
INPUT_DIR = RUN + "/fake-input"
RING = RUN + "/fakeinput-rings/ring0"
# One ring per controller slot: 0 the on-screen gamepad's (this script's), 1 to 3 the physical
# controllers' own, which the app fills and libfakeinput serves to Steam as /dev/hidraw33 to 35.
SLOTS = 4
RINGS = [RUN + "/fakeinput-rings/ring%d" % slot for slot in range(SLOTS)]
LOG = RUN + "/pad.log"
# Android refuses to list /sys, /sys/class and /sys/bus; libfakeinput lists these stand-ins for them
# in the Steam client, so libudev finds the hidraw class.
LISTING = RUN + "/sysfs-listing"

RING_MAGIC, RING_VERSION, EVENT_SIZE, CAPACITY = 0x46494252, 2, 24, 4096
HEADER = 64
RING_SIZE = HEADER + CAPACITY * EVENT_SIZE
FILE_SIZE = RING_SIZE + 64 + 256  # + the IMU block + the Steam Controller block
SNAPSHOT_SEQ, SNAPSHOT_BUTTONS, SNAPSHOT_AXES = 32, 40, 44

# Snapshot button bits (libfakeinput kSnapshotButtons, plus Quick Access at bit 11).
BUTTONS = {"A": 0, "B": 1, "X": 2, "Y": 3, "L1": 4, "R1": 5, "VIEW": 6, "MENU": 7,
           "L3": 8, "R3": 9, "STEAM": 10, "QAM": 11}
ALIASES = {"LB": "L1", "RB": "R1", "SELECT": "VIEW", "BACK": "VIEW", "START": "MENU", "GUIDE": "STEAM",
           "HOME": "STEAM", "LS": "L3", "RS": "R3", "...": "QAM"}
# Snapshot axes: left stick x/y, right stick x/y, right trigger, left trigger, d-pad x/y.
LX, LY, RX, RY, RT, LT, HX, HY = range(8)

INPUT_DEVICES, INPUT_CLASS, UDEV_DATA = "/sys/devices/virtual/input", "/sys/class/input", "/run/udev/data"
EVENT_MINOR_BASE = 64

MAJOR, MINOR = 240, 16
NODE = "hidraw%d" % MINOR
DEVICES = "/sys/devices/droiddeck"
USB = DEVICES + "/usb1"
INTERFACE = USB + "/1-1:1.2"
HID = INTERFACE + "/0003:28DE:1205.0001"
HIDRAW = HID + "/hidraw/" + NODE
SERIAL = "DROIDDECK0001"
REPORT_DESCRIPTOR = bytes([
    0x06, 0xff, 0xff, 0x09, 0x01, 0xa1, 0x01, 0x09, 0x02, 0x09, 0x03, 0x15, 0x00,
    0x26, 0xff, 0x00, 0x75, 0x08, 0x95, 0x40, 0x81, 0x02, 0x09, 0x06, 0x09, 0x07,
    0x15, 0x00, 0x26, 0xff, 0x00, 0x75, 0x08, 0x95, 0x40, 0xb1, 0x02, 0xc0])


def write(path, data):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "wb" if isinstance(data, bytes) else "w") as f:
        f.write(data)


def link(path, target):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    if os.path.lexists(path):
        os.unlink(path)
    os.symlink(target, path)


# A Switch Pro Controller on Bluetooth, which libfakeinput serves as /dev/hidraw22 while the live pad
# type is the Switch Pro (it then lists only that node in /sys/class/hidraw).
SWITCH_MINOR = 22
SWITCH_NODE = "hidraw%d" % SWITCH_MINOR
SWITCH_HID = DEVICES + "/bluetooth/0005:057E:2009.0007"
SWITCH_HIDRAW = SWITCH_HID + "/hidraw/" + SWITCH_NODE
SWITCH_MAC = "02:4c:44:00:00:06"
# The same as libfakeinput's kSwitchProReportDescriptor.
SWITCH_REPORT_DESCRIPTOR = bytes([
    0x05, 0x01, 0x09, 0x05, 0xa1, 0x01, 0x06, 0x01, 0xff,
    0x85, 0x21, 0x09, 0x21, 0x15, 0x00, 0x26, 0xff, 0x00, 0x75, 0x08, 0x95, 0x3f, 0x81, 0x02,
    0x85, 0x30, 0x09, 0x30, 0x95, 0x3f, 0x81, 0x02,
    0x85, 0x31, 0x09, 0x31, 0x95, 0x3f, 0x81, 0x02,
    0x85, 0x3f, 0x09, 0x3f, 0x95, 0x3f, 0x81, 0x02,
    0x85, 0x01, 0x09, 0x01, 0x95, 0x3f, 0x91, 0x02,
    0x85, 0x10, 0x09, 0x10, 0x95, 0x3f, 0x91, 0x02,
    0x85, 0x11, 0x09, 0x11, 0x95, 0x3f, 0x91, 0x02,
    0x85, 0x12, 0x09, 0x12, 0x95, 0x3f, 0x91, 0x02,
    0xc0])


def describe_switch_pro():
    write(SWITCH_HID + "/uevent", "DRIVER=hid-generic\nHID_ID=0005:0000057E:00002009\nHID_NAME=Pro Controller\n"
          "HID_PHYS=bluetooth-droiddeck-6\nHID_UNIQ=%s\nMODALIAS=hid:b0005g0001v0000057Ep00002009\n" % SWITCH_MAC)
    write(SWITCH_HID + "/report_descriptor", SWITCH_REPORT_DESCRIPTOR)
    link(SWITCH_HID + "/subsystem", "/sys/bus/hid")
    write(SWITCH_HIDRAW + "/uevent", "MAJOR=%d\nMINOR=%d\nDEVNAME=%s\n" % (MAJOR, SWITCH_MINOR, SWITCH_NODE))
    write(SWITCH_HIDRAW + "/dev", "%d:%d\n" % (MAJOR, SWITCH_MINOR))
    link(SWITCH_HIDRAW + "/subsystem", "/sys/class/hidraw")
    link(SWITCH_HIDRAW + "/device", SWITCH_HID)
    try:
        link("/sys/dev/char/%d:%d" % (MAJOR, SWITCH_MINOR), SWITCH_HIDRAW)
    except OSError as error:
        print("localdesktop-pad: /sys/dev/char/%d:%d not linked (%s)" % (MAJOR, SWITCH_MINOR, error), file=sys.stderr)
    write("/run/udev/data/c%d:%d" % (MAJOR, SWITCH_MINOR), "I:1\nE:ID_INPUT=1\nE:ID_INPUT_JOYSTICK=1\n")


def describe():
    write(USB + "/uevent", "DEVTYPE=usb_device\nPRODUCT=28de/1205/100\nTYPE=0/0/0\nBUSNUM=001\nDEVNUM=002\n")
    for name, value in (("idVendor", "28de"), ("idProduct", "1205"), ("bcdDevice", "0100"),
                        ("manufacturer", "Valve Software"), ("product", "Steam Deck Controller"),
                        ("serial", SERIAL)):
        write(USB + "/" + name, value + "\n")
    link(USB + "/subsystem", "/sys/bus/usb")
    write(INTERFACE + "/uevent", "DEVTYPE=usb_interface\nPRODUCT=28de/1205/100\nINTERFACE=3/0/0\n")
    write(INTERFACE + "/bInterfaceNumber", "02\n")
    write(INTERFACE + "/bInterfaceClass", "03\n")
    link(INTERFACE + "/subsystem", "/sys/bus/usb")
    write(HID + "/uevent", "DRIVER=hid-steam\nHID_ID=0003:000028DE:00001205\n"
          "HID_NAME=Valve Software Steam Deck Controller\nHID_PHYS=usb-droiddeck-1/input2\n"
          "HID_UNIQ=%s\nMODALIAS=hid:b0003g0001v000028DEp00001205\n" % SERIAL)
    write(HID + "/report_descriptor", REPORT_DESCRIPTOR)
    link(HID + "/subsystem", "/sys/bus/hid")
    write(HIDRAW + "/uevent", "MAJOR=%d\nMINOR=%d\nDEVNAME=%s\n" % (MAJOR, MINOR, NODE))
    write(HIDRAW + "/dev", "%d:%d\n" % (MAJOR, MINOR))
    link(HIDRAW + "/subsystem", "/sys/class/hidraw")
    link(HIDRAW + "/device", HID)
    link("/sys/class/hidraw/" + NODE, HIDRAW)
    try:
        # /sys/dev/char is the app's fake DRM sysfs when the GPU is shown as a render node.
        link("/sys/dev/char/%d:%d" % (MAJOR, MINOR), HIDRAW)
    except OSError as error:
        print("localdesktop-pad: /sys/dev/char/%d:%d not linked (%s)" % (MAJOR, MINOR, error), file=sys.stderr)
    write("/run/udev/data/c%d:%d" % (MAJOR, MINOR), "I:1\nE:ID_INPUT=1\nE:ID_INPUT_JOYSTICK=1\n")
    # class/input: games' libudev finds Steam Input's virtual pads there (libfakeinput writes them).
    for name in ("sys/bus", "sys/class", "sys/devices", "class/hidraw", "class/input", "bus"):
        os.makedirs(LISTING + "/" + name, exist_ok=True)


def clear_stale_pads():
    """Drop the sysfs and udev entries of virtual pads whose ring is gone (Steam died without removing
    them): libfakeinput writes /sys/devices/virtual/input/inputN, /sys/class/input/{inputN,eventN} and
    /run/udev/data/{+input:inputN,c13:64+N} for each /dev/input/eventN it creates."""
    def gone(node):
        return not os.path.exists("%s/.uinput-event%d" % (INPUT_DIR, node))
    for name in os.listdir(INPUT_CLASS) if os.path.isdir(INPUT_CLASS) else ():
        number = name.lstrip("inputevent")
        if number.isdigit() and gone(int(number)):
            os.unlink(INPUT_CLASS + "/" + name)
    for name in os.listdir(INPUT_DEVICES) if os.path.isdir(INPUT_DEVICES) else ():
        if name.startswith("input") and name[5:].isdigit() and gone(int(name[5:])):
            shutil.rmtree(INPUT_DEVICES + "/" + name, ignore_errors=True)
    for name in os.listdir(UDEV_DATA) if os.path.isdir(UDEV_DATA) else ():
        node = None
        if name.startswith("+input:input") and name[12:].isdigit():
            node = int(name[12:])
        elif name.startswith("c13:") and name[4:].isdigit() and int(name[4:]) >= EVENT_MINOR_BASE:
            node = int(name[4:]) - EVENT_MINOR_BASE
        if node is not None and gone(node):
            os.unlink(UDEV_DATA + "/" + name)


def create_ring():
    os.makedirs(INPUT_DIR, exist_ok=True)
    os.makedirs(os.path.dirname(RING), exist_ok=True)
    for path in RINGS:
        with open(path, "wb") as f:
            f.write(struct.pack("<IIII", RING_MAGIC, RING_VERSION, EVENT_SIZE, CAPACITY))
            f.truncate(FILE_SIZE)


# The ring the commands work on: slot 0's unless --slot says otherwise.
current_ring = RING
PAD_TYPE_OFFSET = RING_SIZE + 44  # libfakeinput's DeckImu::pad_type
PAD_TYPES = {0: "deck", 1: "steamcontroller", 2: "xbox360", 3: "dualshock4", 4: "dualsense", 5: "switchpro",
             0xff: "none"}


def ring():
    f = open(current_ring, "r+b")
    return f, mmap.mmap(f.fileno(), FILE_SIZE)


def read_state(m):
    buttons, = struct.unpack_from("<I", m, SNAPSHOT_BUTTONS)
    return buttons, list(struct.unpack_from("<8h", m, SNAPSHOT_AXES))


def write_state(m, buttons, axes):
    # A seqlock, as FakeInputWriter writes it: odd while the fields change.
    seq, = struct.unpack_from("<Q", m, SNAPSHOT_SEQ)
    struct.pack_into("<Q", m, SNAPSHOT_SEQ, seq + 1)
    struct.pack_into("<I", m, SNAPSHOT_BUTTONS, buttons)
    struct.pack_into("<8h", m, SNAPSHOT_AXES, *[max(-32767, min(32767, int(a))) for a in axes])
    struct.pack_into("<Q", m, SNAPSHOT_SEQ, seq + 2)


def button_bits(names):
    bits = 0
    for name in names:
        key = ALIASES.get(name.upper(), name.upper())
        if key not in BUTTONS:
            sys.exit("localdesktop-pad: unknown button %s (%s)" % (name, ", ".join(BUTTONS)))
        bits |= 1 << BUTTONS[key]
    return bits


def side(name, left, right):
    if name not in ("left", "right"):
        sys.exit("localdesktop-pad: left or right, not %s" % name)
    return left if name == "left" else right


def main(args):
    if not args:
        sys.exit(__doc__ or "usage: see the comment at the top of %s" % sys.argv[0])
    global current_ring
    if args[:1] == ["--slot"] and len(args) > 2:
        current_ring = RINGS[int(args[1])]
        args = args[2:]
    command, rest = args[0], args[1:]
    if command == "setup":
        describe()
        describe_switch_pro()
        create_ring()
        clear_stale_pads()
        return
    if command == "env":
        for name, value in (("FAKE_EVDEV_DIR", INPUT_DIR), ("FAKE_EVDEV_MEMFD_PATHS", ";".join("%d=%s" % (slot, path) for slot, path in enumerate(RINGS))),
                            ("FAKE_EVDEV_IDENTITY", "xbox360"), ("FAKE_EVDEV_VIBRATION", "1"),
                            ("FAKE_EVDEV_UINPUT", "1"), ("FAKE_EVDEV_DECK", "1"),
                            ("FAKE_EVDEV_PAD_TYPE", "deck"), ("FAKE_DECK_SYSFS_LISTING", LISTING),
                            ("FAKE_EVDEV_LOG", "1"),
                            ("FAKE_EVDEV_LOG_FILE", LOG), ("SDL_JOYSTICK_DISABLE_UDEV", "1"),
                            ("SDL_HIDAPI_JOYSTICK_DISABLE_UDEV", "1")):
            print("%s=%s" % (name, shlex.quote(value)))  # the ring list has semicolons
        return
    f, m = ring()
    buttons, axes = read_state(m)
    if command == "press":
        buttons |= button_bits(rest)
    elif command == "release":
        buttons &= ~button_bits(rest) if rest else 0
    elif command == "tap":
        held = int(rest[1]) if len(rest) > 1 else 120
        write_state(m, buttons | button_bits(rest[:1]), axes)
        time.sleep(held / 1000)
    elif command == "stick":
        x_axis, y_axis = side(rest[0], (LX, LY), (RX, RY))
        axes[x_axis], axes[y_axis] = float(rest[1]) * 32767, float(rest[2]) * 32767
    elif command == "trigger":
        axes[side(rest[0], LT, RT)] = float(rest[1]) * 255
    elif command == "dpad":
        axes[HX], axes[HY] = {"up": (0, -1), "down": (0, 1), "left": (-1, 0), "right": (1, 0),
                              "none": (0, 0)}[rest[0]]
    elif command == "state":
        held = [name for name, bit in BUTTONS.items() if buttons & (1 << bit)]
        pad_type, = struct.unpack_from("<I", m, PAD_TYPE_OFFSET)
        shown = PAD_TYPES.get(pad_type & 0xff, "?") if pad_type & 0x80000000 else "-"
        print("buttons: %s\naxes: %s\npad type: %s" % (" ".join(held) or "-", axes, shown))
        return
    else:
        sys.exit("localdesktop-pad: unknown command %s" % command)
    write_state(m, buttons, axes)


if __name__ == "__main__":
    main(sys.argv[1:])
