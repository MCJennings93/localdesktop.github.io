#!/bin/sh
# Started by KWin in startplasmamobile-localdesktop, so WAYLAND_DISPLAY/DISPLAY point at KWin here.
# D-Bus-activated services (portals, kded modules) must see KWin's sockets, not the app's.
# KWin may run with OpenGL settings (kwin-localdesktop-gl); clients keep its GPU environment.
# With KWin on OpenGL, KWin offers linux-dmabuf on /dev/dri/renderD0, so Mesa's EGL takes its
# hardware path (Zink on Turnip, frames handed to KWin as dmabufs) and needs neither
# LIBGL_ALWAYS_SOFTWARE nor the kopper shim, which kwin-localdesktop-gl has unset. That variable
# also made Mesa report a software device, so Firefox blocklisted the GPU and rendered on the CPU.
# Same-process clients such as Mesa's need no fences (KGSL runs GPU work in submission order;
# 2026-10-23 synctest: 0 partly drawn frames in 780 deliberately slow ones), and Chromium uses
# explicit sync (kgsl-syncobj.so).
if [ "$LOCALDESKTOP_KWIN_GL" = 1 ]; then
    unset KWIN_COMPOSE KWIN_RENDER_NODES LOCALDESKTOP_KWIN_GL
fi
dbus-update-activation-environment --all
QT_QPA_PLATFORM=offscreen plasma-mobile-envmanager --apply-settings
kded6 &
exec plasmashell -p org.kde.plasma.mobileshell
