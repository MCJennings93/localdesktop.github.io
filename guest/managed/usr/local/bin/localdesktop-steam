#!/bin/sh
# Starts Valve's arm64 Linux Steam client in the Plasma session, installing it first if needed
# (localdesktop-steam-install). It opens in Big Picture; --desktop opens the desktop client instead,
# and --gamemode the Steam Deck UI inside gamescope (localdesktop-gamemode starts it that way).
# --restart shuts a running client down first; --shutdown only shuts it down. Environment and
# arguments follow DroidDeck's droiddeck-session (GPL-3.0). Output goes to /tmp/steam-run.log.
S=${XDG_DATA_HOME:-$HOME/.local/share}/Steam
exec >>/tmp/steam-run.log 2>&1
echo "== $(date '+%F %T') localdesktop-steam $*"
running() { pgrep -f "$S/steamrtarm64/steam( |$)" >/dev/null; }
restart= shutdown= ui=-gamepadui deck=
while :; do
    case ${1:-} in
        --restart) restart=1 ;;
        --shutdown) shutdown=1 ;;
        --desktop) ui=-nobigpicture ;;
        --gamemode) deck="-steamdeck -steamos3" ;;
        *) break ;;
    esac
    shift
done
if [ -n "$restart$shutdown" ]; then
    if running; then
        LD_LIBRARY_PATH=$S/steamrtarm64 "$S/steamrtarm64/steam" -shutdown
        n=0
        while running && [ "$n" -lt 30 ]; do sleep 1; n=$((n + 1)); done
        pkill -9 -f "$S/steamrtarm64/steam" 2>/dev/null
        pkill -9 -f "$S/steamrtarm64/steamwebhelper" 2>/dev/null
    fi
    [ -z "$shutdown" ] || exit 0
fi
localdesktop-steam-install || { echo "== Steam client install failed"; exit 1; }
# Left behind by a killed client: .crash opens the update UI on its spinner, the htmlcache locks can
# leave the UI blank (DroidDeck x86-64-steam-client.md).
if ! running; then
    rm -f "$S/.crash" "$S/steam.pid" "$S"/config/htmlcache/Singleton*
fi
# Steam asks lsof who owns each loopback connection to it (see /usr/local/src/loopback-owner.c);
# sessions started before the preload existed lack it.
case " $LD_PRELOAD " in
    *" /usr/local/lib/loopback-owner.so "*) ;;
    *) export LD_PRELOAD="${LD_PRELOAD:+$LD_PRELOAD }/usr/local/lib/loopback-owner.so" ;;
esac
# The emulated Steam Deck controller: libfakeinput serves it to the client as /dev/hidraw16 (see
# localdesktop-pad). Steam Input then hands games its virtual pad through the same library.
if [ -f /run/localdesktop-pad/fakeinput-rings/ring0 ] && [ -f /usr/local/lib/libfakeinput.so ]; then
    export LD_PRELOAD="$LD_PRELOAD /usr/local/lib/libfakeinput.so"
    eval "$(localdesktop-pad env | sed 's/^/export /')"
fi
export STEAM_RUNTIME=1
# The Deck UI offers gamescope's upscaling (NIS) and scaling filters, which it controls through
# gamescope's X properties.
[ -n "$deck" ] && export STEAM_GAMESCOPE_NIS_SUPPORTED=1 STEAM_GAMESCOPE_FANCY_SCALING_SUPPORT=1
# A containerized client would re-execute itself through pressure-vessel (bwrap) without this.
export STEAM_STEAMRT_RECURSION_GUARD=1
export LD_LIBRARY_PATH=$S/steamrtarm64:$S/steamrtarm64/panorama${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}
# Steam ships its FFmpeg as unversioned libav*.so files without the soname links Valve's runtime
# would make (libavutil.so.59 ...); its other libraries link the sonames. Some sonames are real files
# in Steam's manifest (libavresample.so.4): replacing one makes the client re-extract its whole package
# and restart on every launch, so only missing names are linked.
for lib in "$S"/steamrtarm64/libav*.so "$S"/steamrtarm64/libsw*.so; do
    soname=$(readelf -d "$lib" 2>/dev/null | sed -n 's/.*SONAME.*\[\(.*\)\]/\1/p')
    [ -n "$soname" ] && [ "$soname" != "${lib##*/}" ] || continue
    [ -e "$S/steamrtarm64/$soname" ] || [ -L "$S/steamrtarm64/$soname" ] || ln -s "${lib##*/}" "$S/steamrtarm64/$soname"
done
# "Linux x86 (FEX)" in a game's Compatibility settings: the arm64 client cannot run x86 Linux games itself.
# Steam reads compatibilitytools.d only at startup.
tool=$S/compatibilitytools.d/localdesktop-fex
mkdir -p "$tool"
cat > "$tool/compatibilitytool.vdf" <<'EOF'
"compatibilitytools"
{
	"compat_tools"
	{
		"localdesktop-fex"
		{
			"install_path" "."
			"display_name" "Linux x86 (FEX)"
			"from_oslist" "linux"
			"to_oslist" "linux"
		}
	}
}
EOF
cat > "$tool/toolmanifest.vdf" <<'EOF'
"manifest"
{
	"version" "2"
	"commandline" "/launch %verb%"
	"use_tool_subprocess_reaper" "1"
}
EOF
cat > "$tool/launch" <<'EOF'
#!/bin/sh
verb=$1; shift
case $verb in
    getcompatpath | getnativepath) printf '%s\n' "$1"; exit 0 ;;
esac
exec /usr/local/bin/localdesktop-fex steam "$verb" "$@"
EOF
chmod 755 "$tool/launch"
channel=$(localdesktop-steam-install --channel)
# The client exits with 42 to restart itself after an update, as steam.sh handles; up to five times.
n=0
while :; do
    # shellcheck disable=SC2086
    "$S/steamrtarm64/steam" -clientbeta "$channel" "$ui" $deck -no-cef-sandbox -cef-ozone-platform=x11 \
        -cef-force-gpu -cef-use-gl=angle -cef-use-angle=vulkan "$@"
    rc=$?
    echo "== steam exited rc=$rc"
    [ "$rc" = 42 ] && [ "$n" -lt 5 ] || exit "$rc"
    n=$((n + 1))
done
