#!/bin/sh
# Game Mode, what the Steam menu entry opens: Steam's Steam Deck UI inside gamescope, fullscreen over the Plasma session, as SteamOS
# runs it (and DroidDeck's droiddeck-session, GPL-3.0). Games see the largest 16:9 screen that fits
# the display, at its pixel density (2176x1224 on a near-square foldable screen, 1920x1080 on a 20:9
# phone), and gamescope maps touch onto it. Games assume 16:9; given another shape, some draw a
# 16:9 picture inside it and then misplace touches and the cursor by the bars they added, which
# no layer below the game can correct. Steam's per-game Game Resolution (Native) gives a game
# that handles any shape the whole display. Steam's
# per-game Touchscreen setting decides what a touch does. "Switch to Desktop" in Steam's power menu
# (steamos-session-select) shuts Steam down, which ends gamescope and returns to Plasma.
# LOCALDESKTOP_GAMEMODE_SIZE=WxH sets another game screen (smaller ones are lighter on the GPU).
# Output goes to /tmp/gamemode.log.
exec >>/tmp/gamemode.log 2>&1
echo "== $(date '+%F %T') localdesktop-gamemode $*"
FLAG=/run/localdesktop-pad/gamemode
# gamescope's pid is in $FLAG while it runs (its process is named gamescope-wl, not gamescope).
running() {
    pid=$(cat "$FLAG" 2>/dev/null) && [ -n "$pid" ] && case "$(cat "/proc/$pid/comm" 2>/dev/null)" in gamescope*) true ;; *) false ;; esac
}
# --restart ends a running Game Mode first (Steam shuts down, gamescope ends with it).
if [ "${1:-}" = --restart ]; then
    shift
    if running; then
        localdesktop-steam --shutdown
        n=0
        while running && [ "$n" -lt 30 ]; do sleep 1; n=$((n + 1)); done
        running && kill "$pid"
    fi
fi
# Plasma Mobile minimizes a window when its app is left for the home screen; opening Steam again
# brings Game Mode's window back, through a KWin script.
raise() {
    script=/tmp/localdesktop-raise-gamescope.js
    cat > "$script" <<'JS'
for (const window of workspace.windowList()) {
    if (window.resourceClass == "gamescope") {
        window.minimized = false;
        workspace.activeWindow = window;
    }
}
JS
    id=$(qdbus6 org.kde.KWin /Scripting org.kde.kwin.Scripting.loadScript "$script" localdesktop-raise) &&
        qdbus6 org.kde.KWin "/Scripting/Script$id" org.kde.kwin.Script.run >/dev/null
    qdbus6 org.kde.KWin /Scripting org.kde.kwin.Scripting.unloadScript localdesktop-raise >/dev/null
}
# gamescope opens its window only once Steam shows something, 10 s to a minute after the tap (more
# after a client update), when Plasma Mobile no longer treats it as the app just opened and leaves
# it behind the launcher. A KWin script, loaded for the session, brings each new gamescope window
# to the front.
watch() {
    loaded=$(qdbus6 org.kde.KWin /Scripting org.kde.kwin.Scripting.isScriptLoaded localdesktop-gamescope)
    [ "$loaded" = true ] && return
    script=/tmp/localdesktop-gamescope.js
    cat > "$script" <<'JS'
workspace.windowAdded.connect(function (window) {
    if (window.resourceClass == "gamescope") {
        window.minimized = false;
        workspace.activeWindow = window;
    }
});
JS
    id=$(qdbus6 org.kde.KWin /Scripting org.kde.kwin.Scripting.loadScript "$script" localdesktop-gamescope) &&
        qdbus6 org.kde.KWin "/Scripting/Script$id" org.kde.kwin.Script.run >/dev/null
}
# Steam updates itself before it draws anything (minutes under FEX for a full client update), and its
# own progress window doesn't show in Game Mode. localdesktop-steam-progress shows its progress as a
# notification with a bar until Game Mode's window opens; $STARTING holds its pid meanwhile. Without
# Python's GObject bindings, a plain notification says Steam is starting.
STARTING=/run/localdesktop-pad/gamemode-starting
progress() {
    if python3 -c 'from gi.repository import Gio' 2>/dev/null; then
        localdesktop-steam-progress "$1" &
        echo $! > "$STARTING"
        wait
        rm -f "$STARTING"
    else
        notify-send -a Steam -i /root/.local/share/Steam/public/steam_tray_posix.png "Steam is starting" \
            "Game Mode opens when Steam is ready; after a Steam update it can take minutes."
    fi
}
if running; then
    echo "== gamescope is already running"
    # Still starting (no window to bring back yet): the notification pops up again.
    [ -f "$STARTING" ] && kill -USR1 "$(cat "$STARTING")" 2>/dev/null
    raise
    # A steam:// link goes to the running client.
    [ $# -gt 0 ] && exec localdesktop-steam "$@"
    exit 0
fi
watch
mkdir -p /run/localdesktop-pad && rm -f "$STARTING"
progress $$ </dev/null &
# One Steam client at a time: the desktop one goes first.
localdesktop-steam --shutdown
# The output starts at the panel's size; the nested backend follows the window KWin gives it.
panel=$(DISPLAY=${DISPLAY:-:0} xrandr --current 2>/dev/null | sed -n 's/.*current \([0-9]*\) x \([0-9]*\).*/\1x\2/p')
panel=${panel:-1920x1080}
pw=${panel%x*} ph=${panel#*x}
if [ $((pw * 9)) -le $((ph * 16)) ]; then
    fit=${pw}x$((pw * 9 / 16 / 2 * 2))
else
    fit=$((ph * 16 / 9 / 2 * 2))x$ph
fi
size=${LOCALDESKTOP_GAMEMODE_SIZE:-$fit}
echo "== panel $panel, games at $size"
# The app shows its on-screen gamepad while this pid (gamescope, after exec) is alive.
mkdir -p /run/localdesktop-pad && echo $$ > "$FLAG"
exec gamescope --backend wayland --expose-wayland -f -e \
    -W "${panel%x*}" -H "${panel#*x}" -w "${size%x*}" -h "${size#*x}" \
    --default-touch-mode 4 \
    -- localdesktop-steam --gamemode "$@"
